# Copiar a apps/backend/.env para desarrollo local
# cp .env.example apps/backend/.env

NODE_ENV=development
PORT=3000

# PostgreSQL (Docker publica solo en 127.0.0.1:5433 — no expuesto a la LAN)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=contaduria
DB_USER=contaduria
DB_PASSWORD=contaduria_dev
# Conexiones simultáneas del pool (oficina multi-PC: 15–25 suele alcanzar)
DB_POOL_MAX=20

# JWT — en producción usar un secreto aleatorio largo (≥32 caracteres)
JWT_SECRET=cambiar-este-secreto-en-produccion-minimo-32-caracteres
JWT_EXPIRES_IN=12h

# Frontend: ruta relativa al mismo origen (obligatorio para LAN multi-PC)
# Los clientes abren https://IP-SERVIDOR:3000 — no hardcodear localhost
VITE_API_URL=/api

# HTTPS oficina (opcional en desarrollo; recomendado en producción LAN / PWA)
# Generar con: npm run office:certs
# HTTPS_KEY_PATH=C:/contaduria/infra/certs/contaduria-key.pem
# HTTPS_CERT_PATH=C:/contaduria/infra/certs/contaduria-cert.pem
